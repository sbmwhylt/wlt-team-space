{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node ./seeders/index.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:fresh": "npx sequelize-cli db:migrate:undo:all && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "import:prod-microsites": "node --env-file=.env scripts/importProdMicrosites.js",
    "import:prod-stores": "node --env-file=.env scripts/importProdStores.js",
    "undo:import-prod-microsites": "node --env-file=.env scripts/undoImportProdMicrosites.js",
    "undo:import-prod-stores": "node --env-file=.env scripts/undoImportProdStores.js",
    "stores": "node --env-file=.env scripts/storeImportCli.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.4",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.2",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.1.1",
    "nodemailer": "^7.0.12",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sequelize": "^6.37.7",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.5",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.5"
  }
}
